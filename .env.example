# Copy this file to .env and fill in only the values required by your deployment.
# Never commit .env, production database URLs, service-role keys, or model keys.

# Application / database
DATABASE_URL=sqlite:///./data/callradar.db
MEDIA_ROOT=./data
CORS_ORIGINS=http://localhost:3000
# For any reachable deployment, set a strong value or put the API behind
# an identity-aware proxy. The dashboard passes it server-side only.
API_ACCESS_TOKEN=
MEDIA_URL_TTL_SECONDS=900

# Analysis. Set ANALYSIS_PROVIDER=rules for a no-network local smoke test.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
ANALYSIS_PROVIDER=openai
VALIDATE_EVIDENCE_WITH_LLM=true
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=./work/models
WHISPER_UTTERANCE_GAP_SECONDS=0.8
WHISPER_MAX_UTTERANCE_SECONDS=8.0

# Audio object storage. Keep the Supabase bucket private; the API creates signed URLs.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=call-audio

# Docker Compose development database (replace all defaults before a shared deployment).
POSTGRES_DB=callradar
POSTGRES_USER=callradar
POSTGRES_PASSWORD=change-me-before-shared-deployment
# Optional managed PostgreSQL URL for Docker Compose. It is intentionally
# distinct from DATABASE_URL so native SQLite development still works.
COMPOSE_DATABASE_URL=

# Browser-visible API origin. Do not put service-role or OpenAI secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
